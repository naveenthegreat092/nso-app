# ─── NSO Server Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.

# ── Core ─────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Session ──────────────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ── Admin ────────────────────────────────────────────────────────────────────
# The owner's Indian mobile number (10 digits, starts with 6-9).
# This is NEVER sent to the client. Stored server-side only.
ADMIN_PHONE=9999999999

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In development, defaults to localhost:3000 and localhost:5173 if not set.
# In production, set this explicitly.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── OTP Provider ─────────────────────────────────────────────────────────────
# Options: 'console' (dev) | 'twilio' | 'msg91'
OTP_PROVIDER=console

# Twilio (required when OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# MSG91 (required when OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=NSOORB
MSG91_TEMPLATE_ID=your_msg91_template_id

# ── Payments ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── AI Assistant ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
