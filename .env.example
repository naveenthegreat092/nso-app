# ============================================================
# NSO (New Shopping Orbit) — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# NEVER paste real secrets in chat or logs.
# ============================================================

# ----- Backend Server -----
PORT=5000
NODE_ENV=development   # Change to 'production' on your server

# Session secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_STRING

# ----- Admin Configuration -----
# The owner's phone number (10 digits, no +91 prefix).
# Admin status is granted ONLY to this phone number, configured here on the server.
# Never send this value to the frontend or include it in API responses.
ADMIN_PHONE=REPLACE_WITH_YOUR_10_DIGIT_PHONE_NUMBER

# ----- OTP Provider -----
# Options: 'console' (dev - prints to server log only), 'twilio', 'msg91'
OTP_PROVIDER=console

# Twilio (if OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=REPLACE_WITH_TWILIO_PHONE_NUMBER    # e.g. +1XXXXXXXXXX

# MSG91 (if OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=REPLACE_WITH_MSG91_AUTH_KEY
MSG91_SENDER_ID=REPLACE_WITH_MSG91_SENDER_ID            # 6-char alphanumeric
MSG91_TEMPLATE_ID=REPLACE_WITH_MSG91_OTP_TEMPLATE_ID

# ----- CORS -----
# Comma-separated list of allowed frontend origins.
# In production: set to your deployed frontend URL.
# In development: left blank (all localhost origins allowed).
CORS_ORIGIN=https://your-frontend-domain.com

# ----- Payment Gateway (Razorpay) -----
# Key ID is safe to expose to frontend (used in checkout widget).
# Key Secret MUST stay on backend only — used for webhook signature verification.
RAZORPAY_KEY_ID=REPLACE_WITH_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET

# ----- Database -----
# Currently using JSON file (server/data/db.json) — suitable for MVP.
# For production scale, migrate to PostgreSQL or MongoDB:
# DATABASE_URL=postgresql://user:password@host:5432/nso_db

# ----- Frontend (Vite) -----
# These go in your .env at the project root (not server/.env)
# VITE_API_URL is the backend URL accessible from the user's device.
# For APK builds, this must be a real internet-accessible URL (not localhost).
# VITE_API_URL=https://your-backend-domain.com

# ----- File Storage (for product/provider images) -----
# Currently using base64 inline images — suitable for MVP.
# For production, use Cloudinary or AWS S3:
# CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUDINARY_CLOUD_NAME
# CLOUDINARY_API_KEY=REPLACE_WITH_CLOUDINARY_API_KEY
# CLOUDINARY_API_SECRET=REPLACE_WITH_CLOUDINARY_API_SECRET
